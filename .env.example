# OmniLLMWorkspace の設定。`cp .env.example .env` してから値を書く。
# 認証情報は自己責任で置くこと。`.env` はコミットしない（.gitignore 済み）。
# 空の値は「未設定」として扱う。

# --- アプリ ---------------------------------------------------------------
# ログインはパスキー。最初の端末は、サーバーで次を実行して表示されるリンクから登録する（15分・1回限り）
#   uv run python -m omniws passkey-link
# アプリを開くURL（カンマ区切り）。パスキーはここに書いたHTTPS（Tailscale Serve）か http://localhost でだけ使える
OMNI_PUBLIC_URLS=
# 開発・テスト用のパスワードログイン（普段は空のまま）
OMNI_PASSWORD=
# Cookie署名用の長いランダム文字列（必須。例: openssl rand -hex 32）
OMNI_SECRET=
# 待ち受け。外へはTailscale Serveなどで出す（0.0.0.0にしない）
OMNI_HOST=127.0.0.1
OMNI_PORT=8300
# 会話などを保存するディレクトリ（既定: ./data）
OMNI_DATA_DIR=
# ブラウザで使うホスト名を追加（カンマ区切り。例: myserver.tail1234.ts.net）
OMNI_ALLOWED_HOSTS=

# --- Code のプロジェクト -------------------------------------------------
# この直下のフォルダがプロジェクトになる（画面から選択・作成）。既存のリポジトリはシンボリックリンクで置ける
OMNI_PROJECTS_DIR=~/omni-projects
# 画面からのフォルダ作成と git clone（HTTPS と、サーバーのSSH鍵を使うSSH）を許すか
OMNI_ALLOW_PROJECT_CREATE=true
OMNI_ALLOW_GIT_CLONE=true

# --- API ------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OpenAI互換の別サービスを使うときだけ変える
OPENAI_BASE_URL=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --- ローカルLLM（OpenAI互換） ------------------------------------------
# 例: http://localhost:11434（Dockerからは http://host.docker.internal:11434）
OLLAMA_BASE_URL=
# LM Studio / llama.cpp / vLLM など。例: http://localhost:1234/v1
LOCAL_OPENAI_BASE_URL=
LOCAL_OPENAI_API_KEY=

# --- 使うサービスとモデル -----------------------------------------------
# 使うサービスをカンマ区切りで限定（anthropic,openai,gemini,openrouter,ollama,local）。空なら設定済みのもの全部
OMNI_PROVIDERS=
# モデル一覧を固定したいときだけ（カンマ区切り）。空ならサービスから取得
OMNI_MODELS_ANTHROPIC=
OMNI_MODELS_OPENAI=
OMNI_MODELS_GEMINI=
OMNI_MODELS_OPENROUTER=
OMNI_MODELS_OLLAMA=
OMNI_MODELS_LOCAL=

# --- サブスクリプション（公式CLI経由） ----------------------------------
# 資格情報はここに書かない。各CLIに本人がログインし、そのログインをCLIが使う
#   ChatGPT: codex login
#   Claude: claude auth login。Anthropicの規約上、アプリはClaude.aiの資格情報を扱えない。
#           CLIのログインで使うのは個人利用・自己責任とし、下で明示的に許可したときだけ有効
OMNI_ALLOW_CLAUDE_SUBSCRIPTION=false
# OpenCodeの無料モデル（OpenCodeのサービスで動き、コードがそこへ送られる）を実行元に出すか
OMNI_ALLOW_OPENCODE_FREE=false

# --- Codeモードの権限（.envが上限。設定画面と会話ごとには、これより厳しくだけできる） ---
# 承認モード: ask=読み取り以外は確認 / auto_edit=プロジェクト内の編集は自動・コマンドは確認 / auto=拒否パターン以外は自動
OMNI_APPROVAL_DEFAULT=auto_edit
# 画面で選べる一番緩いモード
OMNI_APPROVAL_MAX=auto
# false にするとコマンド実行は常に拒否
OMNI_ALLOW_SHELL=true
# エージェントのサンドボックスからのネットワーク接続（npm install、git pull など）
OMNI_ALLOW_NETWORK=true
# プロジェクトの外での読み取り（READ）と、それ以外の操作（WRITE: 編集・削除・コマンドなど）
#   mode=承認モードに従う / ask=常に確認 / deny=常に拒否
OMNI_OUTSIDE_READ=mode
OMNI_OUTSIDE_WRITE=mode
# 含まれていたら常に拒否するコマンド（カンマ区切り、語の区切りで判定）
OMNI_SHELL_DENY=sudo,su,rm -rf /,rm -rf ~,mkfs,shutdown,reboot,git push --force,git push -f

# Human-operated terminal: full server-user shell, independent of agent permissions.
OMNI_ALLOW_TERMINAL=false

# Allow linked CLI sessions to be renamed, forked and explicitly deleted.
OMNI_ALLOW_NATIVE_SESSION_CHANGES=true
