# OmniLLMWorkspace の設定。`cp .env.example .env` してから値を書く。
# 認証情報は自己責任で置くこと。`.env` はコミットしない（.gitignore 済み）。
# 空の値は「未設定」として扱う。

# --- アプリ ---------------------------------------------------------------
# ログインパスワード（必須）
OMNI_PASSWORD=
# Cookie署名用の長いランダム文字列（必須。例: openssl rand -hex 32）
OMNI_SECRET=
# 待ち受け。外へはTailscale Serveなどで出す（0.0.0.0にしない）
OMNI_HOST=127.0.0.1
OMNI_PORT=8300
# 会話などを保存するディレクトリ（既定: ./data）
OMNI_DATA_DIR=
# ブラウザで使うホスト名を追加（カンマ区切り。例: myserver.tail1234.ts.net）
OMNI_ALLOWED_HOSTS=

# --- Code のプロジェクト -------------------------------------------------
# この直下のフォルダがプロジェクトになる（画面から選択・作成）
OMNI_PROJECTS_DIR=~/omni-projects

# --- API ------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OpenAI互換の別サービスを使うときだけ変える
OPENAI_BASE_URL=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --- ローカルLLM（OpenAI互換） ------------------------------------------
# 例: http://localhost:11434（Dockerからは http://host.docker.internal:11434）
OLLAMA_BASE_URL=
# LM Studio / llama.cpp / vLLM など。例: http://localhost:1234/v1
LOCAL_OPENAI_BASE_URL=
LOCAL_OPENAI_API_KEY=

# --- 使うサービスとモデル -----------------------------------------------
# 使うサービスをカンマ区切りで限定（anthropic,openai,gemini,openrouter,ollama,local）。空なら設定済みのもの全部
OMNI_PROVIDERS=
# モデル一覧を固定したいときだけ（カンマ区切り）。空ならサービスから取得
OMNI_MODELS_ANTHROPIC=
OMNI_MODELS_OPENAI=
OMNI_MODELS_GEMINI=
OMNI_MODELS_OPENROUTER=
OMNI_MODELS_OLLAMA=
OMNI_MODELS_LOCAL=

# --- サブスクリプション（公式CLI経由、P2） ------------------------------
# 資格情報はここに書かない。各CLIに本人がログインし、そのログインをCLIが使う
#   Claude: claude auth login（Anthropicの規約上、アプリはClaude.aiの資格情報を扱えない。個人利用・自己責任）
#   ChatGPT: codex login
